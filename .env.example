# Valori pubblici usati dal browser. Si trovano in Supabase > Connect.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Facoltativa e solo server: serve esclusivamente alla migrazione una tantum
# degli account legacy. Non usare mai il prefisso NEXT_PUBLIC_ e non committarla.
SUPABASE_SECRET_KEY=sb_secret_your_key
